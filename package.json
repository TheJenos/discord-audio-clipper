{
  "name": "discord-audio-clipper",
  "version": "1.0.0",
  "description": "Discord bot that joins a voice channel, keeps a rolling recording of the conversation, and clips the last few minutes on command.",
  "main": "dist/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts --verbose",
    "deploy-commands": "node dist/deploy-commands.js",
    "deploy-commands:dev": "ts-node src/deploy-commands.ts",
    "setup-voiceclip": "bash scripts/setup-voiceclip.sh"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "discord.js": "^14.15.3",
    "dotenv": "^16.4.5",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "libsodium-wrappers": "^0.7.15",
    "opusscript": "^0.0.8",
    "prism-media": "^1.3.5",
    "sherpa-onnx-node": "^1.13.7"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^20.14.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.0"
  }
}
