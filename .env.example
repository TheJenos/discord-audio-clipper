# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Application (client) ID of the bot, from the same page
CLIENT_ID=

# Optional: register slash commands to a single guild for instant updates
# during development. Leave blank to register commands globally (can take
# up to an hour to propagate).
GUILD_ID=

# How many seconds of audio to keep in the rolling recording buffer.
# /clip cannot return more audio than this.
RECORD_WINDOW_SECONDS=300

# Default number of seconds /clip returns when no argument is given.
DEFAULT_CLIP_SECONDS=300

# How many humans must be in a voice channel to trigger auto-join
# (only applies once /autojoin enable has been run for a server).
AUTO_JOIN_MIN_MEMBERS=4

# How long (seconds) to wait after a voice channel empties before the bot
# actually leaves, in case everyone briefly dropped out.
LEAVE_GRACE_SECONDS=10

# Where per-guild settings (auto-join, excluded channels) are persisted.
DATA_DIR=./data

# --- "clip that" voice trigger (optional) ---
# Lets people say "clip that" out loud to auto-post the last
# WAKE_WORD_CLIP_SECONDS of audio, once /voiceclip enable has been run for a
# server. Uses a free, offline sherpa-onnx keyword-spotting model - no
# account or API key needed. Leave the KWS_* paths blank to disable the
# feature entirely (/voiceclip enable will refuse to turn on without them).
# See docs/GUIDE.md §6 for the one-time setup (download a model, generate a
# keywords file for "clip that").

# Paths to the downloaded model's encoder/decoder/joiner/tokens files.
KWS_ENCODER_PATH=
KWS_DECODER_PATH=
KWS_JOINER_PATH=
KWS_TOKENS_PATH=

# Path to the generated keywords file containing "clip that" (see docs/GUIDE.md §6).
KWS_KEYWORDS_PATH=

# Optional: override the boosting score / triggering threshold baked into
# the keywords file above instead of regenerating it. Leave blank to use
# the file's own values.
KWS_SCORE=
KWS_THRESHOLD=

# How many seconds "clip that" grabs.
WAKE_WORD_CLIP_SECONDS=30
