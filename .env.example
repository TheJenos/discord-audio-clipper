# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Application (client) ID of the bot, from the same page
CLIENT_ID=

# Optional: register slash commands to a single guild for instant updates
# during development. Leave blank to register commands globally (can take
# up to an hour to propagate).
GUILD_ID=

# How many seconds of audio to keep in the rolling recording buffer.
# /clip cannot return more audio than this.
RECORD_WINDOW_SECONDS=300

# Default number of seconds /clip returns when no argument is given.
DEFAULT_CLIP_SECONDS=300
