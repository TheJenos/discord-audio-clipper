# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Application (client) ID of the bot, from the same page
CLIENT_ID=

# Optional: register slash commands to a single guild for instant updates
# during development. Leave blank to register commands globally (can take
# up to an hour to propagate).
GUILD_ID=

# How many seconds of audio to keep in the rolling recording buffer.
# /clip cannot return more audio than this. Capped at 300 (5 minutes);
# anything larger is clamped down to that.
RECORD_WINDOW_SECONDS=300

# Default number of seconds /clip returns when no argument is given.
DEFAULT_CLIP_SECONDS=300

# How many humans must be in a voice channel to trigger auto-join
# (only applies once /autojoin enable has been run for a server).
AUTO_JOIN_MIN_MEMBERS=4

# How long (seconds) to wait after a voice channel empties before the bot
# actually leaves, in case everyone briefly dropped out.
LEAVE_GRACE_SECONDS=10

# Where per-guild settings (auto-join, excluded channels) are persisted.
DATA_DIR=./data

# --- "please clip that" voice trigger (optional) ---
# Lets people say "please clip that" out loud to auto-post the last
# WAKE_WORD_CLIP_SECONDS of audio, once /voiceclip enable has been run for a
# server. Uses a free, offline sherpa-onnx keyword-spotting model - no
# account or API key needed. Leave the KWS_* paths blank to disable the
# feature entirely (/voiceclip enable will refuse to turn on without them).
# See docs/GUIDE.md §6 for the one-time setup (download a model, generate a
# keywords file for "please clip that").

# Paths to the downloaded model's encoder/decoder/joiner/tokens files.
KWS_ENCODER_PATH=
KWS_DECODER_PATH=
KWS_JOINER_PATH=
KWS_TOKENS_PATH=

# Path to the generated keywords file containing "please clip that" (see docs/GUIDE.md §6).
KWS_KEYWORDS_PATH=

# Optional: override the boosting score / triggering threshold baked into
# the keywords file above instead of regenerating it. Leave blank to use
# the file's own values.
KWS_SCORE=
KWS_THRESHOLD=

# Optional, for debugging false negatives/positives: when set, dumps the
# exact audio fed to the KWS model as a .wav file per speaking session into
# this directory.
KWS_DEBUG_AUDIO_DIR=

# How many seconds "please clip that" grabs.
WAKE_WORD_CLIP_SECONDS=30

# --- Transcription-based trigger check (optional, on top of KWS above) ---
# A second, parallel way to catch "please clip that": instead of a narrow
# keyword-spotting model, this transcribes each speaker's audio with an
# offline sherpa-onnx Whisper model once they stop talking, and matches the
# transcript against WAKE_WORD_PHRASES. Either KWS or this detecting the
# phrase triggers a clip. A streaming ASR model (matching KWS's continuous
# design) was tried here first, but testing showed it missing or garbling
# short, quiet trigger phrases far more often than Whisper's offline,
# whole-utterance decoding - the tradeoff is it only fires after a pause,
# not mid-sentence. Leave the ASR_* paths blank to skip this check entirely -
# it's independent of the KWS_* setup above and neither requires the other.
# Run `npm run setup-voiceclip -- --with-asr` to fetch a model and fill these
# in automatically - see docs/GUIDE.md §6 for that and the manual steps.

# Paths to the downloaded Whisper model's encoder/decoder/tokens files.
ASR_ENCODER_PATH=
ASR_DECODER_PATH=
ASR_TOKENS_PATH=

# Comma-separated trigger phrases the transcription check matches against
# (case-insensitive, punctuation-insensitive substring match). Defaults to
# "please clip that" if unset.
WAKE_WORD_PHRASES=please clip that

# Optional: log every transcript the transcription check produces, not just
# ones that match a trigger phrase - noisy, for debugging missed/garbled
# phrases. Same effect as passing --verbose on the command line.
VERBOSE=
